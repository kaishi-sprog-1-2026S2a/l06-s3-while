            "type": "shell",
            "command": "gcc",
            "args": [
                "-g",
                "while_test.c",
                "-o",
                "while_test"
            ]
        },
        {
            "label": "build do_while_test",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-g",
                "do_while_test.c",
                "-o",
                "do_while_test"
            ]
        },
        {
            "label": "build all",
            "type": "shell",
